# Server
HOST=0.0.0.0
PORT=8787
TZ=Pacific/Auckland

# Data directory (SQLite db + recordings live under it)
DATA_DIR=data
DB_PATH=data/korean.db

# Auth (REQUIRED before exposing the app to the internet)
AUTH_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when serving over HTTPS in production (makes the cookie Secure)
COOKIE_SECURE=0

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Leave empty to use the provider's default (flash-lite class) model.
GEMINI_MODEL=
LLM_DAILY_CAP=30